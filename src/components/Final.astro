---
interface Props { heading: string; em?: string; text: string; image?: string }
const { heading, em, text, image = 'walker-on-path' } = Astro.props;
---
<section class="on-dark has-bg final">
  <div class="bg" aria-hidden="true"><img src={`/images/${image}.webp`} alt="" loading="lazy" decoding="async" /></div>
  <div class="wrap final__wrap"><div class="stack final__inner">
    <p class="label">The next step</p>
    <h2 class="h2">{heading}{em && <> <em>{em}</em></>}</h2>
    <p class="lead">{text}</p>
    <p><a class="btn btn--light" href="/contact/">Book a 20-minute call</a></p>
  </div></div>
</section>
<style>
  .final__wrap { padding-block: clamp(88px, 12vw, 160px); }
  .final__inner { max-width: 820px; }
</style>
