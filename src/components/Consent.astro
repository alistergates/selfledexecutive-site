---
// Cookie consent for EU/Swiss rules. Google Analytics only loads after "Accept".
// The choice is remembered in this browser; "Cookie settings" in the footer reopens the banner.
import { GA_ID } from '../data/site.js';
---
{GA_ID && <div class="consent" id="consent" role="dialog" aria-live="polite" aria-label="Cookie preferences" hidden>
  <p>I use Google Analytics cookies to see which pages help people, if you're happy with that. Nothing is shared for advertising. <a href="/privacy-policy/#cookies">Privacy policy</a></p>
  <div class="consent__btns">
    <button type="button" class="consent__btn" data-consent="denied">Decline</button>
    <button type="button" class="consent__btn" data-consent="granted">Accept</button>
  </div>
</div>}

<script is:inline define:vars={{ GA_ID }}>
  (function () {
    if (!GA_ID) return;
    var KEY = 'sle-consent';
    var box = document.getElementById('consent');
    function read() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
    function save(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
    function loadGA() {
      if (window.__gaLoaded) return; window.__gaLoaded = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'granted' });
      gtag('js', new Date());
      gtag('config', GA_ID, { anonymize_ip: true });
      var s = document.createElement('script'); s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(s);
    }
    function choose(v) { save(v); box.hidden = true; if (v === 'granted') loadGA(); }
    box.addEventListener('click', function (e) {
      var v = e.target && e.target.getAttribute && e.target.getAttribute('data-consent');
      if (v) choose(v);
    });
    document.addEventListener('click', function (e) {
      var t = e.target && e.target.closest && e.target.closest('[data-cookie-settings]');
      if (t) { e.preventDefault(); box.hidden = false; }
    });
    var c = read();
    if (c === 'granted') loadGA(); else if (c !== 'denied') box.hidden = false;
  })();
</script>

<style>
  .consent { position: fixed; z-index: 50; left: 16px; right: 16px; bottom: 16px; max-width: 560px; margin-left: auto; background: var(--paper); color: var(--ink); border: 1px solid var(--rule); border-radius: 2px; box-shadow: 0 10px 30px rgba(14, 16, 18, 0.18); padding: 18px 20px; display: flex; flex-direction: column; gap: 14px; font-size: 15px; }
  .consent[hidden] { display: none; }
  .consent p { margin: 0; line-height: 1.5; }
  .consent a { text-underline-offset: 3px; }
  .consent__btns { display: flex; gap: 10px; justify-content: flex-end; }
  .consent__btn { font: inherit; font-weight: 600; cursor: pointer; padding: 10px 20px; border-radius: 2px; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); min-height: 44px; flex: 1 1 0; max-width: 160px; }
</style>
