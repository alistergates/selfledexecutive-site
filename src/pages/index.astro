---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import FieldNotes from '../components/FieldNotes.astro';
import Final from '../components/Final.astro';
import { SITE } from '../data/site.js';

const seo = {
  title: 'IFS for Leaders | Internal Family Systems Coaching for Founders & CEOs',
  description: 'Internal Family Systems (IFS) coaching for founders, CEOs and senior leaders, with Alister Gates: IFS-trained counsellor, former tech CTO and founder who has built and sold several businesses. Online, worldwide.',
};

const parts = [
  { name: 'The Operator', says: '"If I don\'t hold it, it falls."', text: 'Checks everything, can\'t quite delegate, and wonders why the team stays dependent.' },
  { name: 'The Closer', says: '"Win. Then win again."', text: 'Hits the target and moves the goalposts before the result has even landed. Enough never arrives.' },
  { name: 'The Peacekeeper', says: '"Keep everyone happy."', text: 'Says yes to the board, puts off the hard conversation, and quietly builds resentment.' },
  { name: 'The Critic', says: '"Not good enough. Yet."', text: 'Keeps the standards high, and grinds people down along the way, you included.' },
  { name: 'The Firefighter', says: '"Make it stop."', text: 'The drink, the scroll, the blow-up in the meeting. Gets relief fast and leaves a mess.' },
];

const shifts = [
  ['Three days replaying a hostile meeting', 'Back on an even keel in half an hour'],
  ['Explaining it all, again', 'Asking, and a team that steps up'],
  ['Avoiding the hard conversation', 'Having it cleanly, and keeping the relationship'],
  ['"I have to sell, whatever the price"', 'Building value, with options open'],
  ['Snapping or going cold at home', 'Catching the flash before it lands'],
];

const lenses = [
  { label: 'Inside you', title: 'IFS parts work.', text: 'Getting to know the protectors that take over under pressure, and, when you\'re ready, healing what they\'re guarding. This is where lasting change comes from.' },
  { label: 'Between people', title: 'Team, board, home.', text: 'Your co-founder, your leadership team, your hardest client and your marriage. I\'m couples-trained too, and the same pattern usually runs in all of them.' },
  { label: 'In the business', title: 'Founder mentoring.', text: 'A straight commercial view from a former tech CTO who helped raise over $10 million and has built and sold several businesses: the exit, the hire, the strategy, what to stop doing.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService', '@id': `${SITE}/#business`, name: 'The Self-Led Executive', url: `${SITE}/`,
      description: seo.description, image: `${SITE}/images/og.jpg`,
      areaServed: ['Europe', 'United Kingdom', 'Switzerland', 'Middle East', 'United States', 'Australia', 'New Zealand'],
      address: { '@type': 'PostalAddress', addressLocality: 'Zurich', addressCountry: 'CH' },
      founder: { '@id': `${SITE}/#person` },
    },
    {
      '@type': 'Person', '@id': `${SITE}/#person`, name: 'Alister Gates', url: `${SITE}/about/`,
      jobTitle: 'Executive coach and counsellor', image: `${SITE}/images/alister-jersey.jpg`,
      sameAs: ['https://alistergates.com/about/'],
      knowsAbout: ['Internal Family Systems', 'Executive coaching', 'Leadership development', 'Founder coaching', 'Nice Guy Syndrome'],
    },
  ],
};
---
<Base title={seo.title} description={seo.description} schema={schema}>
  <section class="hero on-dark">
    <picture class="hero__img" aria-hidden="true">
      <source media="(max-width: 760px)" srcset="/images/alister-hero-m.webp" />
      <img src="/images/alister-hero.webp" alt="" fetchpriority="high" decoding="async" />
    </picture>
    <div class="wrap hero__inner stack">
      <p class="label">IFS for leaders · Online, worldwide</p>
      <h1 class="h1">Internal Family Systems, <em>for the people in charge.</em></h1>
      <p class="lead">You know what good leadership looks like. IFS explains why, under pressure, something else takes over, and how to put the steadiest version of you back in the chair. I'm Alister Gates: an IFS-trained counsellor, a former tech CTO and a founder who has built and sold several businesses.</p>
      <div class="hero__cta">
        <a class="btn btn--light" href="/contact/">Book a 20-minute call</a>
        <a class="textlink" href="/what-is-ifs/">New to IFS? Start here →</a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap section stack-lg">
      <div class="split">
        <div class="stack"><p class="label">01 — The problem</p><h2 class="h2">You're not short of strategy. <em>Something else is in the way.</em></h2></div>
        <div class="split__body">
          <p>You're capable, you think fast and you deliver. You've read the books and probably done the 360. You know what good leadership looks like.</p>
          <p>And still, in the moments that matter, something else takes over. You watch yourself do the thing you swore you wouldn't, and you can't quite work out who's driving.</p>
        </div>
      </div>
      <div class="grid">
        <div class="cell"><p class="label">At work</p><h3 class="h3">Same meeting, same reaction.</h3><p>The board meeting, the co-founder, the underperformer you still haven't dealt with. You see it coming, and it happens anyway.</p></div>
        <div class="cell"><p class="label">Inside</p><h3 class="h3">Running hot, all the time.</h3><p>The 3am replays. The sense that you can never put it down. Wins that feel like relief rather than satisfaction.</p></div>
        <div class="cell"><p class="label">At home</p><h3 class="h3">Your partner sees it first.</h3><p>The short fuse, the half-present dinners, the laptop open on holiday. The people closest to you usually notice before you do.</p></div>
      </div>
    </div>
  </section>

  <section class="on-dark">
    <div class="wrap section stack-lg">
      <div class="split">
        <div class="stack"><p class="label">02 — What's actually going on</p><h2 class="h2">Meet the team <em>that's been running you.</em></h2></div>
        <div class="split__body">
          <p>You already know you're not one voice. Part of you wants to push and part of you wants to pull back. Part of you is furious, and part of you is worried about what people will think. In Internal Family Systems (IFS) these are called parts.</p>
          <p>Most of them showed up early, when you were young or when the business was fragile. They took on hard jobs and did them well. The trouble is, they're still doing those jobs at full volume, in a company and a life that have moved on.</p>
        </div>
      </div>
      <div class="grid parts">
        {parts.map((p) => (
          <div class="cell"><p class="label">{p.name}</p><h3 class="h3">{p.says}</h3><p>{p.text}</p></div>
        ))}
        <div class="cell parts__self"><p class="label">And underneath</p><h3 class="h3"><em>You, when they settle.</em></h3><p>Calm, clear and curious, and able to hold the room. IFS calls this Self. The work is getting it back in the chair.</p></div>
      </div>
      <p class="lead parts__note">None of these parts are the problem. They're loyal and they're tired. We don't fire them. We find out what they're protecting, so they can ease off.</p>
      <p><a class="textlink" href="/what-is-ifs/">Read the full IFS guide for leaders →</a></p>
    </div>
  </section>

  <section class="tone-stone">
    <div class="wrap section stack-lg">
      <div class="split">
        <div class="stack"><p class="label">03 — How I work</p><h2 class="h2">Three lenses, <em>in one hour.</em></h2></div>
        <div class="split__body"><p>Most leaders get either the inner work or the business advice. You'll get both, because the pattern wrecking your board meeting is usually the one wrecking your Sunday night too.</p><p><a class="textlink" href="/how-i-work/">How I work →</a></p></div>
      </div>
      <div class="grid">{lenses.map((l) => <div class="cell"><p class="label">{l.label}</p><h3 class="h3">{l.title}</h3><p>{l.text}</p></div>)}</div>
    </div>
  </section>

  <section>
    <div class="wrap section split">
      <div class="stack">
        <p class="label">04 — Your guide</p>
        <h2 class="h2">Someone who's <em>sat in your chair.</em></h2>
        <figure class="guide__photo"><img src="/images/alister-jersey.webp" width="896" height="1088" alt="Alister Gates" loading="lazy" decoding="async" /></figure>
      </div>
      <div class="split__body">
        <p>I spent 35 years in business before I became a counsellor. I bought my first company at 25 and worked in tech from 1992 to 2006, patenting and exporting software. As CTO of a software company in the early 2000s, I helped raise over $10 million; I was the one selling the tech story to investors. Since then I've built and sold several businesses, mostly in FMCG, food and health. I've made payroll when I wasn't sure how, and carried the kind of stress you don't take home because there's nobody to hand it to.</p>
        <p>When I trained in Internal Family Systems, I found what I'd been missing for most of my career. It explained why smart, driven people, me included, keep doing the things they know aren't working.</p>
        <p>So I don't come at this as a therapist who has read about business, or a coach with a framework to sell. I've been the leader whose best qualities were quietly running him into the ground.</p>
        <ul class="rules creds">
          <li>35 years in business: software, export, product, marketing</li>
          <li>Internal Family Systems (IFS) Level 2 trained</li>
          <li>Bachelor of Applied Counselling</li>
          <li>Certified Nice Guy Coach with Dr Robert Glover</li>
          <li>Couples training in IFIO and the Developmental Model</li>
        </ul>
        <p><a class="textlink" href="/about/">More about me →</a></p>
      </div>
    </div>
  </section>

  <section class="tone-stone">
    <div class="wrap section stack-lg">
      <div class="split">
        <div class="stack"><p class="label">05 — What changes</p><h2 class="h2">Same person. <em>Different person in charge.</em></h2></div>
        <div class="split__body"><p>This isn't about becoming someone else, or sanding down the edge that makes you good at what you do. It's about who's in charge when the pressure's on.</p><p><a class="textlink" href="/outcomes/">See the outcomes →</a></p></div>
      </div>
      <ol class="shifts">
        {shifts.map(([from, to]) => <li><span class="shifts__from">{from}</span><span class="shifts__arrow" aria-hidden="true">→</span><span class="shifts__to">{to}</span></li>)}
      </ol>
    </div>
  </section>

  <section>
    <div class="wrap section stack-lg">
      <div class="stack"><p class="label">06 — Getting started</p><h2 class="h2">Three steps. <em>No mystery.</em></h2></div>
      <div class="grid">
        <div class="cell"><p class="label">Step 1</p><h3 class="h3">A 20-minute call.</h3><p>You tell me what's going on. I'll tell you honestly whether I can help. No pitch.</p></div>
        <div class="cell"><p class="label">Step 2</p><h3 class="h3">Map the system.</h3><p>We work out which parts are running the show, when they take over, and what they're protecting.</p></div>
        <div class="cell"><p class="label">Step 3</p><h3 class="h3">Lead from Self.</h3><p>We work with real situations from your week: the board, the team, home. You practise, and the change shows up where it counts.</p></div>
      </div>
      <p><a class="btn" href="/contact/">Book a 20-minute call</a></p>
    </div>
  </section>

  <section class="tone-stone">
    <div class="wrap section split">
      <div class="stack"><p class="label">07 — Who this is for</p><h2 class="h2">Leaders who are doing well <em>and know something's off.</em></h2></div>
      <div class="split__body">
        <ul class="rules">
          <li>Leaders who've read about IFS and want to know what it would do for them at work</li>
          <li>Founders and CEOs of growing companies</li>
          <li>Senior leaders stepping into a bigger role than the last one</li>
          <li>Leaders who've just sold, stepped down, or are about to</li>
          <li>Expat executives leading across cultures, a long way from home</li>
          <li>Leaders whose partner has said "something has to change"</li>
        </ul>
        <p class="muted-note">It's probably not for you if you want a framework to tick off, or a performance fix without looking inward. That's fine. It's just a different job.</p>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap section stack-lg">
      <div class="split">
        <div class="stack"><p class="label">08 — Journal</p><h2 class="h2">Recent <em>writing.</em></h2></div>
        <div class="split__body"><p>Practical pieces on IFS and leadership: the patterns that run people at the top, and what changes when they don't.</p><p><a class="textlink" href="/journal/">All articles →</a> &nbsp; <a class="textlink" href="/ifs-glossary/">IFS glossary →</a></p></div>
      </div>
      <PostList limit={3} />
    </div>
  </section>

  <FieldNotes />

  <Final heading="The part of you reading this" em="already knows." text="Twenty minutes on a video call. You tell me what's going on, and I'll tell you straight whether this is the right work for you right now." />
</Base>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; background: #0B111B; }
  .hero__img { position: absolute; inset: 0; z-index: -1; }
  .hero__img img { width: 100%; height: 100%; object-fit: cover; object-position: 85% 30%; filter: saturate(0.85); }
  .hero__img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11,17,27,.92) 0%, rgba(11,17,27,.8) 42%, rgba(11,17,27,.1) 72%, rgba(11,17,27,0) 100%); }
  .hero__inner { padding-block: clamp(88px, 12vw, 170px); }
  .hero__inner > * { max-width: 640px; }
  @media (max-width: 760px) {
    .hero__img { position: relative; display: block; height: 62vh; min-height: 380px; }
    .hero__img img { object-position: 60% 20%; }
    .hero__img::after { background: linear-gradient(180deg, rgba(11,17,27,0) 55%, rgba(11,17,27,1) 100%); }
    .hero__inner { padding-block: 8px 72px; }
  }
  .hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; margin-top: 10px; }
  .hero__cta .textlink { color: var(--paper); }
  .parts { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 900px) { .parts { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .parts { grid-template-columns: 1fr; } }
  .parts .h3 { font-style: italic; }
  .parts__self { background: var(--night-2) !important; }
  .parts__self .h3 { font-style: normal; }
  .parts__note { max-width: 760px; }
  .guide__photo { margin: 18px 0 0; max-width: 380px; }
  .guide__photo img { aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; width: 100%; }
  .creds { font-size: 16px; }
  .creds li { border-color: var(--rule) !important; }
  .shifts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .shifts li { display: grid; grid-template-columns: 1fr auto 1fr; gap: 12px 28px; align-items: baseline; padding: 22px 0; border-bottom: 1px solid var(--rule); }
  .shifts__from { color: var(--muted-2); font-size: 18px; text-decoration: line-through; text-decoration-color: var(--stone-rule); }
  .shifts__arrow { font-family: var(--mono); color: var(--brass); }
  .shifts__to { font-family: var(--serif); font-size: clamp(26px, 2.6vw, 36px); line-height: 1.1; }
  @media (max-width: 700px) { .shifts li { grid-template-columns: 1fr; gap: 4px; } .shifts__arrow { display: none; } }
  .muted-note { color: var(--muted-2); font-size: 16px; }
</style>
