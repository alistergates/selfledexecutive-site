---
import Base from './Base.astro';
import FieldNotes from '../components/FieldNotes.astro';
import { SITE } from '../data/site.js';
import { fmtDate, posts } from '../data/posts';
const { frontmatter, url } = Astro.props;
const fm = frontmatter;
const schema = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: fm.title, description: fm.description,
  datePublished: fm.date, dateModified: fm.updated || fm.date, mainEntityOfPage: new URL(Astro.url.pathname, SITE).href,
  author: { '@id': `${SITE}/#person`, '@type': 'Person', name: 'Alister Gates', url: `${SITE}/about/` },
  publisher: { '@id': `${SITE}/#business` }, image: `${SITE}/images/og.jpg`,
};
const more = posts.filter((p) => p.title !== fm.title).slice(0, 2);
---
<Base title={fm.seoTitle || `${fm.title} | The Self-Led Executive`} description={fm.description} type="article" schema={schema}>
  <article>
    <header class="on-dark">
      <div class="wrap section stack post-head">
        <p class="label">{fm.kicker || 'Journal'} · {fmtDate(fm.date)}</p>
        <h1 class="h1">{fm.title}</h1>
        {fm.standfirst && <p class="lead">{fm.standfirst}</p>}
        <p class="post-by">By Alister Gates</p>
      </div>
    </header>
    <div class="wrap section post-body"><div class="prose"><slot /></div>
      <aside class="post-cta">
        <p class="label">Working on this?</p>
        <p class="post-cta__text">If you recognise yourself here, a 20-minute call is the simplest next step. No pitch, just a straight conversation about whether this is the right work for you.</p>
        <p><a class="btn" href="/contact/">Book a 20-minute call</a></p>
      </aside>
    </div>
  </article>
  {more.length > 0 && (
    <section><div class="wrap section stack keep">
      <p class="label">Keep reading</p>
      <div class="grid">{more.map((p) => <a class="cell more" href={p.url}><h2 class="h3">{p.title}</h2><p>{p.description}</p></a>)}</div>
    </div></section>
  )}
  <FieldNotes />
</Base>
<style>
  .post-head { padding-block: clamp(72px, 10vw, 130px) clamp(56px, 8vw, 96px); }
  .post-head .h1 { font-size: clamp(42px, 5.6vw, 80px); max-width: 1000px; }
  .post-by { font-family: var(--mono); font-size: 14px; color: var(--on-dark-muted); }
  .post-cta { max-width: 680px; margin-top: 56px; padding: clamp(24px, 3.5vw, 36px); border-left: 2px solid var(--brass); background: var(--stone); display: flex; flex-direction: column; gap: 14px; }
  .post-cta__text { font-family: var(--serif); font-size: 26px; line-height: 1.25; }
  .keep { border-top: 1px solid var(--rule); }
  .more { text-decoration: none; }
  .more:hover .h3 { color: var(--brass); }
</style>
